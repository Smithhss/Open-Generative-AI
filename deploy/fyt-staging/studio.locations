# Compatibility reference only; authoritative source is Go deploy/staging/nginx/variants/stage7.conf.
# Do not append this block if stage7 already contains the Studio locations.
    location = /create {
        # STAGING: resolve lazily so an absent studio never blocks the main site.
        resolver 127.0.0.11 valid=10s ipv6=off;
        resolver_timeout 2s;
        set $fyt_studio_backend fyt-studio:3000;
        proxy_pass http://$fyt_studio_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fyt_forwarded_proto;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        # Next middleware supplies this app's CSP and frame policy.
        add_header X-Content-Type-Options nosniff always;
    }
    location ^~ /create/ {
        # STAGING: resolve lazily so an absent studio never blocks the main site.
        resolver 127.0.0.11 valid=10s ipv6=off;
        resolver_timeout 2s;
        set $fyt_studio_backend fyt-studio:3000;
        proxy_pass http://$fyt_studio_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fyt_forwarded_proto;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        # Next middleware supplies this app's CSP and frame policy.
        add_header X-Content-Type-Options nosniff always;
    }
    location = /api/v1/creative-agent {
        # STAGING: resolve lazily so an absent studio never blocks the main site.
        resolver 127.0.0.11 valid=10s ipv6=off;
        resolver_timeout 2s;
        set $fyt_studio_backend fyt-studio:3000;
        proxy_pass http://$fyt_studio_backend/create$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fyt_forwarded_proto;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        # Next middleware supplies this app's CSP and frame policy.
        add_header X-Content-Type-Options nosniff always;
    }
    location ^~ /api/v1/creative-agent/ {
        # STAGING: resolve lazily so an absent studio never blocks the main site.
        resolver 127.0.0.11 valid=10s ipv6=off;
        resolver_timeout 2s;
        set $fyt_studio_backend fyt-studio:3000;
        proxy_pass http://$fyt_studio_backend/create$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fyt_forwarded_proto;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        # Next middleware supplies this app's CSP and frame policy.
        add_header X-Content-Type-Options nosniff always;
    }
